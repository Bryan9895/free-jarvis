FCC_URL=http://127.0.0.1:8082
FCC_MODEL=
FCC_TOKEN=
JARVIS_WORKSPACE=~/Projetos
JARVIS_DB=~/.local/share/jarvis-fcc/memory.sqlite3
# fcc remains the default until real offline acceptance on the target notebook.
JARVIS_PROFILE=fcc
JARVIS_LOCAL_MODEL=gemma4:e2b
JARVIS_OLLAMA_HOST=http://127.0.0.1:11434
# Optional location for the explicitly provisioned Ollama binary/models.
# JARVIS_OLLAMA_DIR=~/.local/share/jarvis-fcc/ollama
# Whisper requires cached weights; prepare explicitly with local install-stt.
# Optional nonempty override. local install-engine selects its verified Python automatically.
JARVIS_OPENJARVIS_PYTHON=
# ADAM: aplicativo nativo Tkinter; não depende de navegador/HTML/servidor web.
# Para ouvir a voz é necessária conexão com a API ElevenLabs:
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_SPEED=1.0
# ADAM_PERSONA_FILE=~/Documentos/adam-persona.md
# Opcional: particulas/FPS (reduza em hardware limitado).
ADAM_PARTICLES=960
ADAM_FPS=30
